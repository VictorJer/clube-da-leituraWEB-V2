@model ExcluirRevistaViewModel

@{
    Layout = "~/Compartilhado/Views/_Layout.cshtml";
    ViewBag.Titulo = "Excluir revista";
}

@section Styles {
    <link rel="stylesheet" href="~/css/caixas.css" />
    <link rel="stylesheet" href="~/css/revistas.css" />
}

<main id="conteudo" class="container py-5">
    <div class="form-page-header mb-4">
        <p class="eyebrow mb-2">Organização do acervo</p>
        <h1 class="page-title mb-2">Excluir revista</h1>
        <p class="text-secondary mb-0">Confirme a exclusão desta edição.</p>
    </div>

    <section class="form-card" aria-labelledby="confirm-title">
        <div class="delete-warning mb-4" role="alert">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            <span>Esta ação não pode ser desfeita.</span>
        </div>
        <h2 id="confirm-title" class="h5 mb-3">Tem certeza que deseja excluir esta revista?</h2>
        <dl class="caixa-details mb-4">
            <div><dt>Título</dt><dd>@Model.Titulo</dd></div>
            <div><dt>Edição</dt><dd>@Model.NumeroEdicao</dd></div>
            <div><dt>Publicação</dt><dd>@Model.AnoPublicacao.ToString("dd/MM/yyyy")</dd></div>
            <div><dt>Caixa</dt><dd>@Model.Caixa</dd></div>
            <div><dt>Status</dt><dd>@Html.DisplayFor(_ => Model.Status)</dd></div>
        </dl>
        <form asp-action="Excluir" method="post">
            <input asp-for="Id" type="hidden" />
            <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2 pt-3 border-top">
                <a asp-action="Listar" class="btn btn-light rounded-pill px-4 py-2">Cancelar</a>
                <button type="submit" class="btn btn-danger fw-semibold rounded-pill px-4 py-2">Excluir revista</button>
            </div>
        </form>
    </section>
</main>
