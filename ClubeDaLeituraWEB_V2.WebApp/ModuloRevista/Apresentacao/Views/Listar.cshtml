@model List<ListarRevistasViewModel>

@{
    Layout = "~/Compartilhado/Views/_Layout.cshtml";
    ViewBag.Titulo = "Revistas";
}

@section Styles {
    <link rel="stylesheet" href="~/css/caixas.css" />
    <link rel="stylesheet" href="~/css/revistas.css" />
}

<main id="conteudo" class="container py-5">
    <header class="d-flex flex-column flex-sm-row align-items-sm-end justify-content-between gap-3 mb-4">
        <div>
            <p class="eyebrow mb-2">Organização do acervo</p>
            <h1 class="page-title mb-2">Revistas</h1>
            <p class="text-secondary mb-0">Consulte títulos, edições, caixas e disponibilidade do acervo.</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3">
            <span class="count-badge px-4">@Model.Count @(Model.Count == 1 ? "revista cadastrada" : "revistas cadastradas")</span>
            <a class="btn btn-outline-success fw-semibold px-4 py-2 rounded-pill" asp-action="Cadastrar">Cadastrar</a>
        </div>
    </header>

    @if (Model.Count == 0)
    {
        <section class="empty-state text-center" aria-labelledby="empty-title">
            <span class="empty-icon" aria-hidden="true"><i class="bi bi-journal-richtext"></i></span>
            <h2 id="empty-title" class="h4 mt-3">Nenhuma revista cadastrada</h2>
            <p class="text-secondary mb-0">As revistas cadastradas serão exibidas aqui.</p>
        </section>
    }
    else
    {
        <div class="table-responsive caixa-table-wrap">
            <table class="table align-middle mb-0">
                <caption class="visually-hidden">Revistas cadastradas, caixa e status atual</caption>
                <thead>
                    <tr>
                        <th scope="col">Título</th>
                        <th scope="col">Edição</th>
                        <th scope="col">Publicação</th>
                        <th scope="col">Caixa</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (ListarRevistasViewModel revista in Model)
                    {
                        <tr>
                            <th scope="row" class="etiqueta-cell">@revista.Titulo</th>
                            <td>@revista.NumeroEdicao</td>
                            <td>@revista.AnoPublicacao.ToString("dd/MM/yyyy")</td>
                            <td>@revista.Caixa</td>
                            <td><span class="status-badge status-@revista.Status.ToString().ToLowerInvariant()">@Html.DisplayFor(_ => revista.Status)</span></td>
                            <td>
                                <div class="d-flex justify-content-end gap-2">
                                    <a class="btn btn-sm btn-outline-primary rounded-pill px-3" asp-action="Editar"
                                       asp-route-id="@revista.Id" aria-label="Editar revista @revista.Titulo">Editar</a>
                                    <a class="btn btn-sm btn-outline-danger rounded-pill px-3" asp-action="Excluir"
                                       asp-route-id="@revista.Id" aria-label="Excluir revista @revista.Titulo">Excluir</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>
