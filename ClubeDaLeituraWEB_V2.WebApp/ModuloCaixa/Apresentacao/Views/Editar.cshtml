@model EditarCaixaViewModel

@{
    Layout = "~/Compartilhado/Views/_Layout.cshtml";
    ViewBag.Titulo = "Editar caixa";
}

@section Styles {
    <link rel="stylesheet" href="~/css/caixas.css" />
}

<main id="conteudo" class="container py-5">
    <div class="form-page-header mb-4">
        <p class="eyebrow mb-2">Organização do acervo</p>
        <h1 class="page-title mb-2">Editar caixa</h1>
        <p class="text-secondary mb-0">Atualize a etiqueta, a cor ou o prazo de empréstimo.</p>
    </div>

    <section class="form-card" aria-label="Editar dados da caixa">
        <form asp-action="Editar" method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-4">
                <label asp-for="Etiqueta" class="form-label fw-semibold">Etiqueta</label>
                <input asp-for="Etiqueta"
                       class="form-control form-control-lg"
                       placeholder="Ex.: Aventura e fantasia"
                       autocomplete="off"
                       autofocus />
                <span asp-validation-for="Etiqueta" class="field-validation-error"></span>
                <div class="form-text">Use um nome fácil de reconhecer, com até 50 caracteres.</div>
            </div>

            <div class="mb-4">
                <label asp-for="Cor" class="form-label fw-semibold">Cor da caixa</label>
                <div class="d-flex align-items-center gap-3">
                    <input asp-for="Cor"
                           type="color"
                           class="form-control form-control-color color-picker"
                           title="Escolha a cor da caixa" />
                    <span class="form-text mt-0">Escolha uma cor para identificar esta caixa.</span>
                </div>
                <span asp-validation-for="Cor" class="field-validation-error"></span>
            </div>

            <div class="mb-4">
                <label asp-for="DiasDeEmprestimo" class="form-label fw-semibold">Dias de empréstimo</label>
                <div class="input-group input-group-lg prazo-input">
                    <input asp-for="DiasDeEmprestimo"
                           type="number"
                           class="form-control"
                           min="1"
                           step="1"
                           inputmode="numeric" />
                    <span class="input-group-text">dias</span>
                </div>
                <span asp-validation-for="DiasDeEmprestimo" class="field-validation-error"></span>
                <div class="form-text">O prazo deve ser maior que zero.</div>
            </div>

            <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2 pt-3 border-top">
                <a asp-action="Listar" class="btn btn-light rounded-pill px-4 py-2">Cancelar</a>
                <button type="submit" class="btn btn-outline-primary fw-semibold rounded-pill px-4 py-2">
                    <i class="bi bi-check2 me-1" aria-hidden="true"></i>
                    Salvar alterações
                </button>
            </div>
        </form>
    </section>
</main>