@model ExcluirCaixaViewModel

@{
    Layout = "~/Compartilhado/Views/_Layout.cshtml";
    ViewBag.Titulo = "Excluir caixa";
    string corOriginal = Model.Cor ?? string.Empty;
    string cor = System.Text.RegularExpressions.Regex.IsMatch(corOriginal, @"\A#[0-9a-fA-F]{6}\z")
        ? corOriginal
        : "#763c45";
}

@section Styles {
    <link rel="stylesheet" href="~/css/caixas.css" />
}

<main id="conteudo" class="container py-5">
    <div class="d-flex justify-content-center">
        <div class="form-page-header mb-4">
            <p class="eyebrow mb-2">Organização do acervo</p>
            <h1 class="page-title mb-2">Excluir caixa</h1>
            <p class="text-secondary mb-0">Confirme a exclusão desta caixa.</p>
        </div>
    </div>


    <section class="form-card" aria-labelledby="confirm-title">
        <div class="delete-warning mb-4" role="alert">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            <span>Esta ação não pode ser desfeita.</span>
        </div>

        <h2 id="confirm-title" class="h5 mb-3">Tem certeza que deseja excluir esta caixa?</h2>

        <dl class="caixa-details mb-4">
            <div>
                <dt>Etiqueta</dt>
                <dd>@Model.Etiqueta</dd>
            </div>
            <div>
                <dt>Cor</dt>
                <dd>
                    <span class="color-value">
                        <span class="color-swatch" style="background-color: @cor" aria-hidden="true"></span>
                        @Model.Cor
                    </span>
                </dd>
            </div>
            <div>
                <dt>Prazo de empréstimo</dt>
                <dd>@Model.DiasDeEmprestimo @(Model.DiasDeEmprestimo == 1 ? "dia" : "dias")</dd>
            </div>
        </dl>

        <form asp-action="Excluir" method="post">
            <input asp-for="Id" type="hidden" />
            <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2 pt-3 border-top">
                <a asp-action="Listar" class="btn btn-light rounded-pill px-4 py-2">Cancelar</a>
                <button type="submit" class="btn btn-danger fw-semibold rounded-pill px-4 py-2">
                    <i class="bi bi-trash me-1" aria-hidden="true"></i>
                    Excluir caixa
                </button>
            </div>
        </form>
    </section>
</main>