@{
    Layout = "~/Compartilhado/Views/_Layout.cshtml";
    ViewBag.Titulo = "Página Inicial";
}

@section Styles {
    <style>
        .hero {
            overflow: hidden;
            padding: 5.5rem 0 5rem;
            position: relative;
        }

        .hero::before {
            background: radial-gradient(ellipse, rgba(220, 229, 215, .8), rgba(220, 229, 215, 0) 68%);
            content: "";
            height: 520px;
            position: absolute;
            right: -160px;
            top: -160px;
            width: 520px;
            z-index: -1;
        }

        .eyebrow {
            color: var(--wine);
            font-size: .77rem;
            font-weight: 750;
            letter-spacing: .16em;
            text-transform: uppercase;
        }

        .hero h1 {
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(3rem, 6vw, 5.35rem);
            letter-spacing: -.065em;
            line-height: .99;
            max-width: 680px;
        }

        .hero h1 em {
            color: var(--wine);
            font-weight: 400;
        }

        .hero-copy {
            color: var(--muted);
            font-size: 1.08rem;
            line-height: 1.75;
            max-width: 510px;
        }

        .btn-wine {
            --bs-btn-bg: var(--wine);
            --bs-btn-border-color: var(--wine);
            --bs-btn-color: #fff;
            --bs-btn-hover-bg: var(--wine-dark);
            --bs-btn-hover-border-color: var(--wine-dark);
            --bs-btn-hover-color: #fff;
            --bs-btn-active-bg: var(--wine-dark);
            --bs-btn-active-border-color: var(--wine-dark);
            border-radius: 999px;
            font-weight: 650;
            padding: .8rem 1.25rem;
        }

        .btn-soft {
            border-radius: 999px;
            color: var(--ink);
            font-weight: 650;
            padding: .8rem 1.1rem;
        }

        .btn-soft:hover {
            color: var(--wine);
        }

        .book-scene {
            align-items: center;
            display: flex;
            justify-content: center;
            min-height: 360px;
            position: relative;
        }

        .book-glow {
            align-items: center;
            background: #e9ede2;
            border-radius: 50%;
            display: flex;
            height: 310px;
            justify-content: center;
            width: 310px;
        }

        .book-cover {
            align-items: center;
            background: linear-gradient(145deg, #98645e, #763c45 68%);
            border: 8px solid rgba(255, 255, 255, .2);
            border-radius: 9px 17px 17px 9px;
            box-shadow: 18px 24px 35px rgba(65, 43, 35, .22), inset 8px 0 0 rgba(38, 24, 23, .15);
            color: #f5dfad;
            display: flex;
            flex-direction: column;
            height: 240px;
            justify-content: center;
            outline: 1px solid rgba(255, 255, 255, .45);
            outline-offset: -17px;
            position: relative;
            transform: rotate(-8deg);
            width: 175px;
        }

        .book-cover .bi {
            font-size: 3.1rem;
            margin-bottom: .7rem;
        }

        .book-cover span {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 1.05rem;
            letter-spacing: .04em;
        }

        .floating-note {
            background: rgba(255, 255, 255, .9);
            border: 1px solid rgba(233, 227, 217, .8);
            border-radius: 15px;
            box-shadow: 0 12px 35px rgba(44, 39, 31, .08);
            color: var(--ink);
            font-size: .86rem;
            font-weight: 650;
            padding: .8rem 1rem;
            position: absolute;
        }

        .floating-note .bi {
            color: var(--wine);
            margin-right: .4rem;
        }

        .note-top {
            right: -5px;
            top: 45px;
            transform: rotate(3deg);
        }

        .note-bottom {
            bottom: 38px;
            left: 0;
            transform: rotate(-3deg);
        }

        .section-heading {
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(2rem, 4vw, 3rem);
            letter-spacing: -.045em;
        }

        .section-copy {
            color: var(--muted);
        }

        .module-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            height: 100%;
            padding: 1.5rem;
            transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease;
        }

        .module-card:hover {
            border-color: #d8c8c2;
            box-shadow: 0 14px 32px rgba(44, 39, 31, .06);
            transform: translateY(-4px);
        }

        .module-icon {
            align-items: center;
            background: #f3ebe7;
            border-radius: 13px;
            color: var(--wine);
            display: inline-flex;
            font-size: 1.25rem;
            height: 48px;
            justify-content: center;
            width: 48px;
        }

        .module-card h3 {
            font-size: 1.05rem;
            font-weight: 700;
        }

        .module-card p {
            color: var(--muted);
            font-size: .92rem;
            line-height: 1.65;
            margin-bottom: 0;
        }

        .about-panel {
            background: var(--sage);
            border-radius: 24px;
            overflow: hidden;
            position: relative;
        }

        .about-panel::after {
            color: rgba(74, 96, 69, .12);
            content: "\F4A5";
            font-family: "bootstrap-icons";
            font-size: 12rem;
            line-height: 1;
            position: absolute;
            right: 2rem;
            top: 50%;
            transform: translateY(-50%) rotate(-12deg);
        }

        .about-content {
            position: relative;
            z-index: 1;
        }

        .site-footer {
            border-top: 1px solid var(--line);
            color: var(--muted);
            font-size: .88rem;
        }

        @@media (max-width: 767.98px) {
            .hero {
                padding: 4rem 0 3rem;
            }

            .book-scene {
                margin-top: 1rem;
                min-height: 320px;
            }

            .book-glow {
                height: 270px;
                width: 270px;
            }

            .note-top {
                right: 0;
            }

            .note-bottom {
                left: 0;
            }

            .about-panel::after {
                font-size: 8rem;
                right: -1rem;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                scroll-behavior: auto !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
}

<main id="conteudo">
    <section class="hero" id="inicio">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <p class="eyebrow mb-3"><i class="bi bi-stars me-2" aria-hidden="true"></i>Boas histórias são melhores juntas</p>
                    <h1 class="mb-4">Uma história pode <em>aproximar</em> todo mundo.</h1>
                    <p class="hero-copy mb-4">Um cantinho para cuidar dos seus quadrinhos, compartilhar aventuras e manter cada empréstimo no caminho de volta para casa.</p>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <a class="btn btn-wine" href="#modulos">Conheça o clube <i class="bi bi-arrow-down-right ms-2" aria-hidden="true"></i></a>
                        <a class="btn btn-soft" href="#sobre">Como funciona</a>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="book-scene" role="img" aria-label="Ilustração de um livro cercado por pequenos lembretes">
                        <div class="book-glow">
                            <div class="book-cover">
                                <i class="bi bi-book-half" aria-hidden="true"></i>
                                <span>Boas histórias</span>
                            </div>
                        </div>
                        <div class="floating-note note-top"><i class="bi bi-bookmark-heart" aria-hidden="true"></i>Histórias para compartilhar</div>
                        <div class="floating-note note-bottom"><i class="bi bi-arrow-repeat" aria-hidden="true"></i>Uma aventura de cada vez</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="pb-5" id="modulos">
        <div class="container py-4 py-lg-5">
            <div class="row align-items-end justify-content-between mb-4 mb-lg-5">
                <div class="col-lg-7">
                    <p class="eyebrow mb-2">Tudo em seu lugar</p>
                    <h2 class="section-heading mb-2">Um clube feito para compartilhar.</h2>
                </div>
                <div class="col-lg-4">
                    <p class="section-copy mb-0">Organize o acervo e acompanhe o que faz cada leitura chegar mais longe: as pessoas.</p>
                </div>
            </div>

            <div class="row g-3 g-lg-4">
                <div class="col-sm-6 col-lg-3">
                    <article class="module-card">
                        <span class="module-icon mb-3"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                        <h3>Caixas</h3>
                        <p>Separe os quadrinhos por caixas e encontre cada coleção com facilidade.</p>
                    </article>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <article class="module-card">
                        <span class="module-icon mb-3"><i class="bi bi-journal-richtext" aria-hidden="true"></i></span>
                        <h3>Revistas</h3>
                        <p>Tenha os títulos, edições e disponibilidade do acervo sempre organizados.</p>
                    </article>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <article class="module-card">
                        <span class="module-icon mb-3"><i class="bi bi-people" aria-hidden="true"></i></span>
                        <h3>Amigos</h3>
                        <p>Guarde as informações de quem faz parte dessa rede de leitores.</p>
                    </article>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <article class="module-card">
                        <span class="module-icon mb-3"><i class="bi bi-arrow-left-right" aria-hidden="true"></i></span>
                        <h3>Empréstimos</h3>
                        <p>Acompanhe as retiradas e devoluções para nenhuma aventura se perder.</p>
                    </article>
                </div>
            </div>
        </div>
    </section>

    <section class="container pb-5" id="sobre">
        <div class="about-panel p-4 p-md-5">
            <div class="about-content col-lg-8 py-lg-2">
                <p class="eyebrow mb-2">Mais que uma coleção</p>
                <h2 class="section-heading mb-3">Leitura boa é leitura compartilhada.</h2>
                <p class="section-copy mb-0">O Clube da Leitura nasceu para aproximar amigos por meio dos quadrinhos. Cuide do acervo, empreste com carinho e deixe as histórias seguirem seu caminho.</p>
            </div>
        </div>
    </section>
</main>

<footer class="site-footer mt-4">
    <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 py-4">
        <a class="d-flex align-items-center gap-2 text-decoration-none" href="/#inicio">
            <span class="brand-mark" style="height: 32px; width: 32px; border-radius: 9px;"><i class="bi bi-book-half" aria-hidden="true"></i></span>
            <span class="brand-name">Clube da Leitura</span>
        </a>
        <span>Feito para histórias que merecem ser compartilhadas.</span>
    </div>
</footer>
