@{
    Layout = "~/Compartilhado/Views/_Layout.cshtml";
    ViewBag.Titulo = "Página Inicial";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<main id="conteudo">
    <section class="hero" id="inicio">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <p class="eyebrow mb-3"><i class="bi bi-stars me-2" aria-hidden="true"></i>Boas histórias são
                        melhores juntas</p>
                        <h1 class="mb-4">Uma história pode <em>aproximar</em> todo mundo.</h1>
                        <p class="hero-copy mb-4">Um cantinho para cuidar dos seus quadrinhos, compartilhar aventuras e
                            manter cada empréstimo no caminho de volta para casa.</p>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <a class="btn btn-wine" href="#modulos">Conheça o clube <i class="bi bi-arrow-down-right ms-2"
                                                                                               aria-hidden="true"></i></a>
                                    <a class="btn btn-soft" href="#sobre">Como funciona</a>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="book-scene" role="img"
                                     aria-label="Ilustração de um livro cercado por pequenos lembretes">
                                    <div class="book-glow">
                                        <div class="book-cover">
                                            <i class="bi bi-book-half" aria-hidden="true"></i>
                                            <span>Boas histórias</span>
                                        </div>
                                    </div>
                                    <div class="floating-note note-top"><i class="bi bi-bookmark-heart"
                                                                               aria-hidden="true"></i>Histórias para compartilhar</div>
                                        <div class="floating-note note-bottom"><i class="bi bi-arrow-repeat" aria-hidden="true"></i>Uma
                                            aventura de cada vez</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="pb-5" id="modulos">
                            <div class="container py-4 py-lg-5">
                                <div class="row align-items-end justify-content-between mb-4 mb-lg-5">
                                    <div class="col-lg-7">
                                        <p class="eyebrow mb-2">Tudo em seu lugar</p>
                                        <h2 class="section-heading mb-2">Um clube feito para compartilhar.</h2>
                                    </div>
                                    <div class="col-lg-4">
                                        <p class="section-copy mb-0">Organize o acervo e acompanhe o que faz cada leitura chegar mais longe:
                                            as pessoas.</p>
                                        </div>
                                    </div>


                                    @* //============================================================================== *@
                                    <div class="row g-3 g-lg-4">
                                        <div class="col-sm-6 col-lg-3">
                                            <a asp-controller="Caixa" asp-action="Listar" class="text-decoration-none text-reset">
                                                <article class="module-card">
                                                    <span class="module-icon mb-3"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                                                    <h3>Caixas</h3>
                                                    <p>Separe os quadrinhos por caixas e encontre cada coleção com facilidade.</p>
                                                </article>
                                            </a>

                                        </div>
                                        <div class="col-sm-6 col-lg-3">
                                            <a asp-controller="Revista" asp-action="Listar" class="text-decoration-none text-reset">
                                                <article class="module-card">
                                                    <span class="module-icon mb-3"><i class="bi bi-journal-richtext"
                                                                                          aria-hidden="true"></i></span>
                                                        <h3>Revistas</h3>
                                                        <p>Tenha os títulos, edições e disponibilidade do acervo sempre organizados.</p>
                                                    </article>
                                                </a>
                                            </div>
                                            <div class="col-sm-6 col-lg-3">
                                                <a asp-controller="Amigo" asp-action="Listar" class="text-decoration-none text-reset">
                                                    <article class="module-card">
                                                        <span class="module-icon mb-3"><i class="bi bi-people" aria-hidden="true"></i></span>
                                                        <h3>Amigos</h3>
                                                        <p>Guarde as informações de quem faz parte dessa rede de leitores.</p>
                                                    </article>
                                                </a>
                                            </div>
                                            <div class="col-sm-6 col-lg-3">
                                                <a asp-controller="Emprestimo" asp-action="Listar" class="text-decoration-none text-reset">
                                                    <article class="module-card">
                                                        <span class="module-icon mb-3"><i class="bi bi-arrow-left-right"
                                                                                              aria-hidden="true"></i></span>
                                                            <h3>Empréstimos</h3>
                                                            <p>Acompanhe as retiradas e devoluções para nenhuma aventura se perder.</p>
                                                        </article>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </section>
                                    @* //============================================================================== *@



                                    <section class="container pb-5" id="sobre">
                                        <div class="about-panel p-4 p-md-5">
                                            <div class="about-content col-lg-8 py-lg-2">
                                                <p class="eyebrow mb-2">Mais que uma coleção</p>
                                                <h2 class="section-heading mb-3">Leitura boa é leitura compartilhada.</h2>
                                                <p class="section-copy mb-0">O Clube da Leitura nasceu para aproximar amigos por meio dos quadrinhos.
                                                    Cuide do acervo, empreste com carinho e deixe as histórias seguirem seu caminho.</p>
                                                </div>
                                            </div>
                                        </section>
                                    </main>

                                    <footer class="site-footer mt-4">
                                        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 py-4">
                                            <a class="d-flex align-items-center gap-2 text-decoration-none" href="/#inicio">
                                                <span class="brand-mark" style="height: 32px; width: 32px; border-radius: 9px;"><i class="bi bi-book-half"
                                                                                                                                       aria-hidden="true"></i></span>
                                                    <span class="brand-name">Clube da Leitura</span>
                                                </a>
                                                <span>Feito para histórias que merecem ser compartilhadas.</span>
                                            </div>
                                        </footer>
