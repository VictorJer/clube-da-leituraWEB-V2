<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f5ef" />
    <title>@ViewBag.Titulo - Clube da Leitura</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.min.css" />
    <style>
            :root {
                --paper: #f8f5ef;
                --ink: #28251f;
                --muted: #716c62;
                --wine: #763c45;
                --wine-dark: #5d2e36;
                --sage: #dce5d7;
                --line: #e9e3d9;
            }

            body {
                background: var(--paper);
                color: var(--ink);
                font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            }

            .site-nav {
                background: rgba(248, 245, 239, .94);
                border-bottom: 1px solid var(--line);
            }

            .brand-mark {
                align-items: center;
                background: var(--wine);
                border-radius: 12px;
                color: #fff;
                display: inline-flex;
                height: 42px;
                justify-content: center;
                width: 42px;
            }

            .brand-name {
                color: var(--ink);
                font-size: 1.05rem;
                font-weight: 750;
                letter-spacing: -.04em;
            }

            .site-nav .nav-link {
                color: var(--muted);
                font-size: .94rem;
                font-weight: 550;
            }

            .site-nav .nav-link:hover,
            .site-nav .nav-link:focus {
                color: var(--wine);
            }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <a class="visually-hidden-focusable position-absolute top-0 start-0 m-3 p-2 bg-white" href="#conteudo">Pular para o
        conteúdo</a>

        <nav class="site-nav sticky-top">
            <nav class="navbar navbar-expand-md container py-3" aria-label="Navegação principal">
                <a class="navbar-brand d-flex align-items-center gap-2 m-0" href="/#inicio"
                   aria-label="Clube da Leitura - início">
                    <span class="brand-mark"><i class="bi bi-book-half" aria-hidden="true"></i></span>
                    <span class="brand-name">Clube da Leitura</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal" aria-controls="menuPrincipal" aria-expanded="false"
                        aria-label="Abrir menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav ms-auto align-items-md-center gap-md-3 pt-3 pt-md-0">
                        <li class="nav-item"><a class="nav-link" href="/#modulos">O clube</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#sobre">Como funciona</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#modulos">Nosso acervo</a></li>
                    </ul>
                </div>
            </nav>
        </nav>

        @RenderBody()

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>